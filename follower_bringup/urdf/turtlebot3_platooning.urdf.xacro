<robot name="turtlebot3_platooning" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />

  <xacro:include filename="$(find turtlebot3_manipulation_description)/gazebo/materials.xacro" />
  <xacro:include filename="$(find turtlebot3_manipulation_description)/xacro/turtlebot3_platooning.xacro" />

  <xacro:turtlebot3_waffle_pi prefix="$(arg prefix)" />
</robot>
